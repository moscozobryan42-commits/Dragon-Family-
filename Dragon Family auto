-- Función auxiliar para crear inputs estilizados
local function crearInput(nombrePlaceholder, posicionY)
	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0, 240, 0, 36)
	textBox.Position = UDim2.new(0.5, -120, 0, posicionY)
	textBox.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
	textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	textBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
	textBox.Font = Enum.Font.GothamMedium
	textBox.TextSize = 13
	textBox.PlaceholderText = nombrePlaceholder
	textBox.Text = ""
	textBox.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = textBox

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(50, 50, 65)
	stroke.Thickness = 1
	stroke.Parent = textBox

	return textBox
end

