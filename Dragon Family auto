-- 2. LÓGICA DE MINIMIZAR / MAXIMIZAR
local minimizado = false
minimizeBtn.MouseButton1Click:Connect(function()
	minimizado = not minimizado
	
	-- Elementos que se ocultan al minimizar
	local ocultarComponentes = {delayInput, radiusInput, zoneInput, zoneVisualBtn, toggleBtn}
	
	if minimizado then
		minimizeBtn.Text = "+"
		frame.Size = UDim2.new(0, 280, 0, 45) -- Reduce la ventana solo a la barra superior
		for _, elemento in ipairs(ocultarComponentes) do
			elemento.Visible = false
		end
	else
		minimizeBtn.Text = "-"
		frame.Size = UDim2.new(0, 280, 0, 310) -- Restaura el tamaño completo
		for _, elemento in ipairs(ocultarComponentes) do
			elemento.Visible = true
		end
	end
end)

-- 3. VARIABLES Y LÓGICA DE LA ZONA VISUAL
local mostrarZonaVisual = false
local zonaVisualPart = nil

zoneVisualBtn.MouseButton1Click:Connect(function()
	if minimizado then return end
	mostrarZonaVisual = not mostrarZonaVisual
	
	if mostrarZonaVisual then
		zoneVisualBtn.Text = "Zona Visual: ON"
		zoneVisualBtn.TextColor3 = Color3.fromRGB(100, 255, 150)
		zoneVisualBtn.BackgroundColor3 = Color3.fromRGB(30, 60, 45)
		
		local radioVal = tonumber(radiusInput.Text) or 15
		zonaVisualPart = Instance.new("Part")
		zonaVisualPart.Name = "ZonaDeJuegoVisual"
		zonaVisualPart.Shape = Enum.PartType.Ball
		zonaVisualPart.Size = Vector3.new(radioVal * 2, radioVal * 2, radioVal * 2)
		zonaVisualPart.Transparency = 0.85
		zonaVisualPart.BrickColor = BrickColor.new("Cyan")
		zonaVisualPart.Material = Enum.Material.Neon
		zonaVisualPart.Anchored = true
		zonaVisualPart.CanCollide = false
		zonaVisualPart.Parent = workspace
	else
		zoneVisualBtn.Text = "Zona Visual: OFF"
		zoneVisualBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
		zoneVisualBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
		
		if zonaVisualPart then
			zonaVisualPart:Destroy()
			zonaVisualPart = nil
		end
	end
end)

game:GetService("RunService").RenderStepped:Connect(function()
	if mostrarZonaVisual and zonaVisualPart then
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			zonaVisualPart.Position = hrp.Position
			local radioVal = tonumber(radiusInput.Text) or 15
			zonaVisualPart.Size = Vector3.new(radioVal * 2, radioVal * 2, radioVal * 2)
		end
	end
end)

-- 4. LÓGICA DE AUTO-PROMPT
local corriendo = false
local loopTarea

toggleBtn.MouseButton1Click:Connect(function()
	corriendo = not corriendo

	if corriendo then
		toggleBtn.Text = "DETENER"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(235, 60, 60)

		local tiempoEspera = tonumber(delayInput.Text) or 1
		local radioMaximo = tonumber(radiusInput.Text) or 99999
		local nombreZonaFiltro = zoneInput.Text ~= "" and zoneInput.Text or nil

		loopTarea = task.spawn(function()
			while corriendo do
				local character = player.Character
				local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")

				if humanoidRootPart then
					local contenedorBusqueda = workspace
					if nombreZonaFiltro then
						local zonaEncontrada = workspace:FindFirstChild(nombreZonaFiltro, true)
						if zonaEncontrada then
							contenedorBusqueda = zonaEncontrada
						end
					end

					for _, objeto in pairs(contenedorBusqueda:GetDescendants()) do
						if objeto:IsA("ProximityPrompt") then
							local parentPart = objeto.Parent
							local posicionPrompt = nil
							
							if parentPart:IsA("BasePart") then
								posicionPrompt = parentPart.Position
							elseif parentPart:IsA("Model") and parentPart.PrimaryPart then
								posicionPrompt = parentPart.PrimaryPart.Position
							elseif parentPart:IsA("Model") then
								local primeraParte = parentPart:FindFirstChildWhichIsA("BasePart")
								if primeraParte then
									posicionPrompt = primeraParte.Position
								end
							end

							local dentroDelRadio = true
							if posicionPrompt and radioMaximo then
								local distancia = (humanoidRootPart.Position - posicionPrompt).Magnitude
								if distancia > radioMaximo then
									dentroDelRadio = false
								end
							end

							if dentroDelRadio and objeto.Enabled then
								if fireproximityprompt then
									fireproximityprompt(objeto)
								end
							end
						end
					end
				end

				task.wait(tiempoEspera)
			end
		end)
	else
		toggleBtn.Text = "INICIAR"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 136, 255)

		if loopTarea then
			task.cancel(loopTarea)
		end
	end
end)

