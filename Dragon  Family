local registeredCards = {}
local registeredStrokes = {}
local registeredAccents = {}

local function applyTheme(themeData, themeName)
	currentTheme = themeData
	if themeName then _G.DragonHub_SavedTheme = themeName end

	mainFrame.BackgroundColor3 = themeData.Background
	titleBar.BackgroundColor3 = themeData.Header
	toggleBtn.BackgroundColor3 = themeData.Header
	toggleBtn.TextColor3 = themeData.Accent
	tStroke.Color = themeData.Accent
	mStroke.Color = themeData.Border
	fpsLabel.TextColor3 = themeData.Accent
	minimizeBtn.TextColor3 = themeData.Accent

	for _, card in ipairs(registeredCards) do card.BackgroundColor3 = themeData.Card end
	for _, stroke in ipairs(registeredStrokes) do stroke.Color = themeData.Border end
	for _, acc in ipairs(registeredAccents) do acc.TextColor3 = themeData.Accent end
end

