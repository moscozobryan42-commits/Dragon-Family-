local function getRandomPositionInArea()
   if not posEsquina1 or not posEsquina2 then return nil end
   local minX = math.min(posEsquina1.X, posEsquina2.X)
   local maxX = math.max(posEsquina1.X, posEsquina2.X)
   local minZ = math.min(posEsquina1.Z, posEsquina2.Z)
   local maxZ = math.max(posEsquina1.Z, posEsquina2.Z)
   local avgY = (posEsquina1.Y + posEsquina2.Y) / 2

   local randX = minX + (math.random() * (maxX - minX))
   local randZ = minZ + (math.random() * (maxZ - minZ))
   return CFrame.new(randX, avgY + 3, randZ)
end

