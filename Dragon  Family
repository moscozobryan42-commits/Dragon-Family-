-- BUCLE AUTO PRESS PROMPTS
task.spawn(function()
   while task.wait(0.1) do
      if autoSpamPrompt then
         local char = player.Character
         if char and char:FindFirstChild("HumanoidRootPart") then
            local playerPos = char.HumanoidRootPart.Position
            
            for _, prompt in ipairs(workspace:GetDescendants()) do
               if prompt:IsA("ProximityPrompt") and prompt.Enabled and prompt.Parent then
                  local promptPart = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                  if promptPart and (playerPos - promptPart.Position).Magnitude <= maxPromptDistance then
                     if fireproximityprompt then
                        fireproximityprompt(prompt)
                     else
                        prompt.HoldDuration = 0
                     end
                  end
               end
            end

            for _, obj in ipairs(workspace:GetDescendants()) do
               if obj:IsA("ClickDetector") and obj.Parent then
                  if (playerPos - obj.Parent.Position).Magnitude <= maxPromptDistance then
                     fireclickdetector(obj)
                  end
               elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                  if obj.Parent and obj.Parent:IsA("BasePart") then
                     if (playerPos - obj.Parent.Position).Magnitude <= maxPromptDistance then
                        for _, child in ipairs(obj:GetDescendants()) do
                           if child:IsA("TextLabel") or child:IsA("TextButton") then
                              if child.Text:lower():find("place") or child.Text:lower():find("poner") or child.Text:lower():find("press") then
                                 local tool = char:FindFirstChildOfClass("Tool")
                                 if tool then
                                    tool:Activate()
                                 else
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                 end
                              end
                           end
                        end
                     end
                  end
               end
            end
         end
      end
   end
end)

