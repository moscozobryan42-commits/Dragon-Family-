local function applyJumpImpulse()
	if not isJumpBoostActive then return end
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	
	if root and hum then
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, jumpPowerVal, root.AssemblyLinearVelocity.Z)
	end
end

UserInputService.JumpRequest:Connect(function()
	applyJumpImpulse()
end)

RunService.RenderStepped:Connect(function()
	local char = player.Character
	if char and not isFlying then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		
		if hum and root then
			if isTpBoostActive and hum.MoveDirection.Magnitude > 0 then
				root.CFrame = root.CFrame + (hum.MoveDirection * tpSpeedDistance)
			end
		end
	end
end)

flyBtn.MouseButton1Click:Connect(function()
	isFlying = not isFlying
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart

	if isFlying then
		flyBtn.Text = "🚀 Desactivar Fly"
		flyBtn.BackgroundColor3 = THEME.Danger
		
		local a0 = Instance.new("Attachment", root); a0.Name = "FlyA0"; a0.Position = Vector3.new(0, 1, 0)
		local a1 = Instance.new("Attachment", root); a1.Name = "FlyA1"; a1.Position = Vector3.new(0, -1, 0)
		flyTrail = Instance.new("Trail", root)
		flyTrail.Attachment0 = a0; flyTrail.Attachment1 = a1
		flyTrail.Color = ColorSequence.new(currentTheme.Accent, Color3.fromRGB(0, 100, 50))
		flyTrail.Lifetime = 0.5; flyTrail.WidthScale = NumberSequence.new(1, 0)

		local bv = Instance.new("BodyVelocity", root); bv.Name = "CoolFlyVel"; bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		local bg = Instance.new("BodyGyro", root); bg.Name = "CoolFlyGyro"; bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); bg.P = 10000

		flyConnection = RunService.RenderStepped:Connect(function()
			if not isFlying then return end
			local cam = workspace.CurrentCamera
			local moveDir = char.Humanoid.MoveDirection
			bg.CFrame = cam.CFrame * CFrame.Angles(0, 0, -moveDir.X * 0.3)
			bv.Velocity = (cam.CFrame.LookVector * (-moveDir.Z) + cam.CFrame.RightVector * moveDir.X) * flySpeed
		end)
	else
		flyBtn.Text = "🚀 Activar Fly"
		flyBtn.BackgroundColor3 = currentTheme.AccentDark
		if flyConnection then flyConnection:Disconnect() end
		if root:FindFirstChild("CoolFlyVel") then root.CoolFlyVel:Destroy() end
		if root:FindFirstChild("CoolFlyGyro") then root.CoolFlyGyro:Destroy() end
		if root:FindFirstChild("FlyA0") then root.FlyA0:Destroy() end
		if root:FindFirstChild("FlyA1") then root.FlyA1:Destroy() end
		if flyTrail then flyTrail:Destroy() end
	end
end)

