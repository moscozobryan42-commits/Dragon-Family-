               currentTool:Activate()
            else
               local targetItem = nil
               for _, item in ipairs(bp:GetChildren()) do
                  if item:IsA("Tool") and (item.Name:find(autoTargetBlockName) or item.Name:find("Lucky Block")) then
                     targetItem = item
