		row.BackgroundTransparency = 1

		local tpBtn = createBtn(row, "📍 " .. item.Name, currentTheme.Header, function()
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				player.Character.HumanoidRootPart.CFrame = item.CFrame
			end
		end)
		tpBtn.Size = UDim2.new(0.76, 0, 1, 0)

		local delBtn = createBtn(row, "✕", THEME.Danger, function()
			table.remove(savedPositions, index)
			renderSavedPositions()
		end)
		delBtn.Size = UDim2.new(0.2, 0, 1, 0)
		delBtn.Position = UDim2.new(0.8, 0, 0, 0)
