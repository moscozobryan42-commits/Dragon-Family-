local function switchTab(index)
	for i, p in ipairs(panels) do
		local isSelected = (i == index)
		p.Visible = isSelected
		TweenService:Create(tabs[i], TweenInfo.new(0.2), {
			BackgroundColor3 = isSelected and currentTheme.Accent or currentTheme.Card,
			TextColor3 = isSelected and Color3.fromRGB(10, 16, 13) or THEME.TextSecondary
		}):Play()
	end
end

