local stopRecordBtn = createBtn(secCopy, "⏹ Detener Grabación", currentTheme.Header, function() end)
local playLoopBtn = createBtn(secCopy, "🔁 Repetir Movimientos", currentTheme.AccentDark, function() end)

local function stopRecordingLogic()
	if isRecording then
		isRecording = false
		if recConnection then recConnection:Disconnect(); recConnection = nil end
		recordBtn.Text = "🔴 Empezar Grabación"; recordBtn.BackgroundColor3 = THEME.Danger
		stopRecordBtn.BackgroundColor3 = currentTheme.Header
	end
end

recordBtn.MouseButton1Click:Connect(function()
	if isRecording then return end
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	isRecording = true; recordedFrames = {}
	recordBtn.Text = "🔴 Grabando..."; recordBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
	stopRecordBtn.BackgroundColor3 = THEME.Danger

	local startTime = tick()
	recConnection = RunService.Heartbeat:Connect(function()
		local elapsed = tick() - startTime
		if not isRecording or (recordTime ~= math.huge and elapsed >= recordTime) then
			stopRecordingLogic(); return
		end
		table.insert(recordedFrames, char.HumanoidRootPart.CFrame)
	end)
end)

stopRecordBtn.MouseButton1Click:Connect(function() stopRecordingLogic() end)

playLoopBtn.MouseButton1Click:Connect(function()
	if isPlayingLoop then
		isPlayingLoop = false
		if loopConnection then loopConnection:Disconnect() end
		if ghostClone then ghostClone:Destroy() end
		playLoopBtn.Text = "🔁 Repetir Movimientos"
		playLoopBtn.BackgroundColor3 = currentTheme.AccentDark
		return
	end

	if #recordedFrames == 0 then
		playLoopBtn.Text = "¡Primero Graba!"
		task.wait(1)
		playLoopBtn.Text = "🔁 Repetir Movimientos"
		return
	end

	isPlayingLoop = true
	playLoopBtn.Text = "⏹ Detener Repetición"
	playLoopBtn.BackgroundColor3 = THEME.Danger

	local char = player.Character
	char.Archivable = true; ghostClone = char:Clone(); char.Archivable = false
	ghostClone.Parent = workspace
	
	for _, part in pairs(ghostClone:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false; part.Transparency = 0.5; part.Color = currentTheme.Accent
		end
	end

	local currentIndex = 1
	loopConnection = RunService.Heartbeat:Connect(function()
		if not isPlayingLoop or not ghostClone or not ghostClone:FindFirstChild("HumanoidRootPart") then return end
		ghostClone.HumanoidRootPart.CFrame = recordedFrames[currentIndex]
		currentIndex = currentIndex + 1
		if currentIndex > #recordedFrames then currentIndex = 1 end
	end)
end)

