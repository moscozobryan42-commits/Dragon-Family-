toggleLoopBtn.MouseButton1Click:Connect(function()
	if isAutoTpRunning then
		isAutoTpRunning = false
		toggleLoopBtn.Text = "▶ Iniciar Bucle"
		toggleLoopBtn.BackgroundColor3 = currentTheme.AccentDark
	else
		if #autoTpWaypoints == 0 then
			toggleLoopBtn.Text = "¡Agrega al menos 1 punto!"
			task.wait(1.5)
			toggleLoopBtn.Text = "▶ Iniciar Bucle"
			return
		end
		
		isAutoTpRunning = true
		toggleLoopBtn.Text = "⏹ Detener Bucle"
		toggleLoopBtn.BackgroundColor3 = THEME.Danger

		task.spawn(function()
			local currentLoop = 0
			while isAutoTpRunning do
				if autoTpMaxLoops > 0 and currentLoop >= autoTpMaxLoops then break end
				for _, targetCFrame in ipairs(autoTpWaypoints) do
					if not isAutoTpRunning then break end
					local char = player.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						char.HumanoidRootPart.CFrame = targetCFrame
					end
					task.wait(autoTpDelay)
				end
				currentLoop = currentLoop + 1
			end
			isAutoTpRunning = false
			toggleLoopBtn.Text = "▶ Iniciar Bucle"
			toggleLoopBtn.BackgroundColor3 = currentTheme.AccentDark
		end)
	end
end)

