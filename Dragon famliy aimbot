-- ========================================================
-- DRAGON FAMILY HUB - ULTIMATE PRO (DEFINITIVE EDITION)
-- ========================================================
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Carga asíncrona del script secundario
task.spawn(function()
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/moscozobryan42-commits/Dragon-Family-/main/Dragon%20Family%20auto"))()
    end)
end)

local Window = Rayfield:CreateWindow({
   Name = "Dragon Family Hub | Ultimate Pro",
   LoadingTitle = "Cargando Sistema...",
   LoadingSubtitle = "by Ultimate Edition",
   ConfigurationSaving = { Enabled = false }
})

-- VARIABLES DE ESTADO
local zonas = {}
local nombresZonas = {"(Vacío)"}
local zonaSeleccionadaIndex = 1
local autoClickerActivo = false
local enRutina = false

-- VARIABLES DE TP SPEED
local tpSpeedActivo = false
local velocidadTP = 80

-- PESTAÑAS
local TabPrincipal = Window:CreateTab("Gestión de Zonas", 4483362458)
local TabConfig = Window:CreateTab("Configuración & TP Speed", 4483362458)
local TabAuto = Window:CreateTab("Auto-Buy / Clicker", 4483362458)
local TabVisual = Window:CreateTab("Visuales (ESP)", 4483362458)

local dropdownZonasRef

local function actualizarDropdown()
    nombresZonas = {}
    if #zonas == 0 then
        table.insert(nombresZonas, "(Vacío)")
    else
        for i, _ in ipairs(zonas) do
            table.insert(nombresZonas, "Punto " .. i)
        end
    end
    if dropdownZonasRef then
        dropdownZonasRef:Refresh(nombresZonas, true)
    end
end

-- ==========================================
-- GESTIÓN DE ZONAS (TIEMPO Y ELIMINAR INDIVIDUAL)
-- ==========================================
TabPrincipal:CreateSection("Crear y Administrar Puntos")

TabPrincipal:CreateButton({
   Name = "💾 Guardar Zona Actual",
   Callback = function()
      local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
      if not root then return end
      
      table.insert(zonas, {
          CFrame = root.CFrame,
          Tiempo = 5 -- Tiempo por defecto en segundos
      })
      actualizarDropdown()
      Rayfield:Notify({Title = "Punto Guardado", Content = "Se añadió el Punto #" .. #zonas, Duration = 2})
   end,
})

dropdownZonasRef = TabPrincipal:CreateDropdown({
   Name = "Seleccionar Punto Específico",
   Options = nombresZonas,
   CurrentOption = "(Vacío)",
   Callback = function(Option)
      for i, nombre in ipairs(nombresZonas) do
          if nombre == Option then
              zonaSeleccionadaIndex = i
              break
          end
      end
   end,
})

TabPrincipal:CreateSlider({
   Name = "Cambiar Segundos del Punto Seleccionado",
   Range = {1, 60},
   Increment = 1,
   CurrentValue = 5,
   Callback = function(Value)
      if zonas[zonaSeleccionadaIndex] then
          zonas[zonaSeleccionadaIndex].Tiempo = Value
      end
   end,
})

TabPrincipal:CreateButton({
   Name = "❌ Eliminar Punto Seleccionado",
   Callback = function()
      if zonas[zonaSeleccionadaIndex] then
          table.remove(zonas, zonaSeleccionadaIndex)
          actualizarDropdown()
          Rayfield:Notify({Title = "Punto Eliminado", Content = "El punto seleccionado fue borrado.", Duration = 2})
      else
          Rayfield:Notify({Title = "Aviso", Content = "No hay un punto válido seleccionado.", Duration = 2})
      end
   end,
})

-- Motor de Movimiento (Soporta TP Speed On/Off)
local function moverFluido(destinoCFrame)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if tpSpeedActivo then
        root.Anchored = true
        local dist = (root.Position - destinoCFrame.Position).Magnitude
        local tiempo = dist / velocidadTP
        local tween = TweenService:Create(root, TweenInfo.new(tiempo, Enum.EasingStyle.Linear), {CFrame = destinoCFrame})
        tween:Play()
        tween.Completed:Wait()
        root.Anchored = false
    else
        root.CFrame = destinoCFrame
    end
end

TabPrincipal:CreateToggle({
   Name = "▶️ Iniciar Ruta (Repeat)",
   CurrentValue = false,
   Callback = function(Value)
      enRutina = Value
      if enRutina then
         if #zonas == 0 then
             Rayfield:Notify({Title = "Aviso", Content = "No hay puntos guardados.", Duration = 2})
             enRutina = false
             return
         end
         task.spawn(function()
            while enRutina do
               for _, data in ipairs(zonas) do
                  if not enRutina then break end
                  moverFluido(data.CFrame)
                  task.wait(data.Tiempo)
               end
            end
         end)
      end
   end,
})

-- ==========================================
-- CONFIGURACIÓN & TP SPEED (CON ON/OFF)
-- ==========================================
TabConfig:CreateSection("Ajustes de Desplazamiento")

TabConfig:CreateToggle({
   Name = "Activar/Desactivar TP Speed",
   CurrentValue = false,
   Callback = function(Value)
      tpSpeedActivo = Value
      Rayfield:Notify({Title = "TP Speed", Content = Value and "Activado (Fluido)" or "Desactivado (Instantáneo)", Duration = 2})
   end,
})

TabConfig:CreateSlider({
   Name = "Velocidad de Movimiento (TP Speed)",
   Range = {20, 250},
   Increment = 5,
   CurrentValue = 80,
   Callback = function(Value)
      velocidadTP = Value
   end,
})

-- ==========================================
-- AUTO-BUY / CLICKER (CENTRO DE PANTALLA)
-- ==========================================
TabAuto:CreateSection("Automatización de Pantalla")

TabAuto:CreateToggle({
   Name = "Auto-Buy / Clicker Sostenido (Centro)",
   CurrentValue = false,
   Callback = function(Value)
      autoClickerActivo = Value
      if autoClickerActivo then
         task.spawn(function()
            while autoClickerActivo do
               local x = camera.ViewportSize.X / 2
               local y = camera.ViewportSize.Y / 2
               
               VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
               task.wait(1.2)
               VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
               task.wait(0.5)
            end
         end)
      end
   end,
})

-- ==========================================
-- VISUALES (ESP)
-- ==========================================
TabVisual:CreateSection("Herramientas Visuales")

TabVisual:CreateToggle({
   Name = "ESP Jugadores",
   CurrentValue = false,
   Callback = function(Value)
      for _, p in pairs(Players:GetPlayers()) do
         if p ~= player and p.Character then
            local highlight = p.Character:FindFirstChild("DragonHighlight")
            if Value and not highlight then
               highlight = Instance.new("Highlight", p.Character)
               highlight.Name = "DragonHighlight"
               highlight.FillColor = Color3.fromRGB(0, 150, 255)
            elseif not Value and highlight then
               highlight:Destroy()
            end
         end
      end
   end,
})

Rayfield:Notify({
   Title = "Sistema Actualizado",
   Content = "TP Speed, gestión individual y Auto-Buy cargados.",
   Duration = 4
})
