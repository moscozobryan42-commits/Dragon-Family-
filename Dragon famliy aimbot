-- Función para hacer cualquier UI arrastrable
local function hacerArrastrable(objeto)
    local arrastrando = false
    local offset = UDim2.new()

    objeto.InputBegan:Connect(function(input)
        if uiBloqueado then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            arrastrando = true
            offset = UDim2.new(0, input.Position.X - objeto.AbsolutePosition.X, 0, input.Position.Y - objeto.AbsolutePosition.Y)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if uiBloqueado then 
            arrastrando = false
            return 
        end
        if arrastrando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            objeto.Position = UDim2.new(0, input.Position.X - offset.X.Offset, 0, input.Position.Y - offset.Y.Offset)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            arrastrando = false
        end
    end)
end

