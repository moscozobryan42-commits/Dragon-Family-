-- Función auxiliar para verificar si hay una pared de por medio (Raycast)
local function estaVisible(targetPart)
    local origen = camera.CFrame.Position
    local destino = targetPart.Position
    local direccion = destino - origen

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local listaIgnorados = {player.Character}
    if targetPart.Parent then
        table.insert(listaIgnorados, targetPart.Parent)
    end
    raycastParams.FilterDescendantsInstances = listaIgnorados

    local resultadoRaycast = workspace:Raycast(origen, direccion, raycastParams)

    if resultadoRaycast then
        return false
    end
    
    return true
end

-- 4. GESTIÓN DE ESP (HIGHLIGHTS)
RunService.RenderStepped:Connect(function()
    if not sesionIniciada then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local char = p.Character
            local highlight = char:FindFirstChild("AimAssistESP")
            
            if espActivo then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "AimAssistESP"
                    highlight.Adornee = char
                    highlight.Parent = char
                end
                highlight.FillColor = colorActivoVerde
                highlight.OutlineColor = Color3.new(1, 1, 1)
                highlight.Enabled = true
            else
                if highlight then
                    highlight.Enabled = false
                end
            end
        end
    end

    if esConsola then return end
    
    -- 5. LÓGICA DE AIM ASSIST
    local mejorObjetivo = nil
    local distMin = DISTANCIA_MAXIMA

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local root = p.Character.HumanoidRootPart
            local pos, enPantalla = camera:WorldToViewportPoint(root.Position)
            
            if enPantalla then
                local centro = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
                local dist = (Vector2.new(pos.X, pos.Y) - centro).Magnitude
                
                if dist < distMin and estaVisible(root) then
                    distMin = dist
                    mejorObjetivo = root
                end
            end
        end
    end

    if mejorObjetivo then
        local targetCFrame = CFrame.new(camera.CFrame.Position, mejorObjetivo.Position)
        camera.CFrame = camera.CFrame:Lerp(targetCFrame, FUERZA_SUAVIDAD)
    end
end)
